# perfect-ai-stack — environment template
# Copy to .env (gitignored) and fill in only what you need.
# Every value below is the docker-compose default, so with Ollama running
# locally you can skip this file entirely (no API keys required).

# ── Optional API keys — only needed for cloud models ─────────────────
# OPENAI_API_KEY=sk-...        # DeepSeek / GPT-4o
# ANTHROPIC_API_KEY=sk-ant-... # Claude

# ── Lore — leave unset: defaults point Lore at LiteLLM inside the stack ──
# LORE_UPSTREAM_OPENAI=http://litellm:4000/v1
# LORE_UPSTREAM_ANTHROPIC=http://litellm:4000/v1
# LORE_WORKER_UPSTREAM=http://litellm:4000/v1
# LORE_WORKER_MODEL=llama3.1:8b
# LORE_WORKER_API_KEY=sk-litellm-master
# LORE_DEBUG=true
